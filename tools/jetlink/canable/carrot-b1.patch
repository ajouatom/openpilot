+// Carrot host query: hardware mode, latest TX outcome, accepted sequence.
+// TX success is the controller TXBTO bit, not merely acceptance by USB.
+void can_query(uint8_t *out)
+{
+    const char hex[] = "0123456789ABCDEF";
+    uint32_t control = can_handle.Instance->CCCR;
+    uint32_t psr = can_handle.Instance->PSR;
+    uint32_t ir = can_handle.Instance->IR;
+    uint32_t ecr = can_handle.Instance->ECR;
+    out[0] = 'Q';
+    out[1] = bus_state == OFF_BUS ? 'C' :
+        ((control & FDCAN_CCCR_MON) ? 'L' :
+        ((control & FDCAN_CCCR_DAR) && !(control & (FDCAN_CCCR_TEST | FDCAN_CCCR_INIT)) ? 'T' : 'E'));
+    if (bus_state == ON_BUS && (psr & FDCAN_PSR_BO)) out[1] = 'E';
+    out[2] = '0';
+    if (txqueue.head != txqueue.tail || (last_tx_buffer &&
+        HAL_FDCAN_IsTxBufferMessagePending(&can_handle, last_tx_buffer))) out[2] = '1';
+    else if (last_tx_failed) out[2] = '3';
+    else if (last_tx_buffer) {
+        if (can_handle.Instance->TXBTO & last_tx_buffer) out[2] = '2';
+        else if (can_handle.Instance->TXBCF & last_tx_buffer)
+            out[2] = (ir & (FDCAN_IR_PEA | FDCAN_IR_PED | FDCAN_IR_BO)) ? '3' : '4';
+        else out[2] = '1'; // Request state has not propagated yet.
+    }
+    for (int i = 0; i < 4; i++) out[3+i] = hex[(tx_sequence >> (12-4*i)) & 15];
+    uint32_t values[3] = {psr, ir, ecr};
+    for (int j = 0; j < 3; j++)
+        for (int i = 0; i < 8; i++) out[7+j*8+i] = hex[(values[j] >> (28-4*i)) & 15];
+    out[31] = '\r';
+}
