# Discord Developer Portal에서 만든 Bot Token
DISCORD_BOT_TOKEN=여기에_직접_입력

# OpenAI Platform 프로젝트에서 만든 API Key (ChatGPT Pro 구독과 별도)
OPENAI_API_KEY=여기에_직접_입력

# Discord 개발자 모드에서 복사한 #carrotpilot-질문 채널 ID
DISCORD_CHANNEL_ID=0

# 전용 질문 채널의 모든 일반 메시지에 답하려면 false
# 봇을 멘션한 메시지에만 답하려면 true
REQUIRE_MENTION=false

# 과거 Discord 대화 검색에서 우선 참고할 사용자 ID. 여러 명이면 쉼표로 구분
PRIORITY_DISCORD_USER_IDS=

# 비용과 응답 설정
OPENAI_MODEL=gpt-5-mini
DAILY_QUESTION_LIMIT=100
MAX_TOOL_ROUNDS=4

# carrotpilot 저장소
GIT_REPO_URL=https://github.com/ajouatom/openpilot.git
GIT_BRANCH=carrot-wip
GIT_UPDATE_MINUTES=60

# 컨테이너 내부 경로. 일반적으로 변경하지 않습니다.
REPO_PATH=/repos/openpilot
DATABASE_PATH=/data/carrotpilot_bot.sqlite3

# Synology openpilot 공유폴더의 carrot-wip 장치 로그(읽기 전용)
DEVICE_LOGS_PATH=/device-logs
