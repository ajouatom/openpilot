FROM python:3.12-slim AS native_builder
RUN apt-get update && apt-get install --no-install-recommends --yes g++ \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir Cython==3.2.9 setuptools
WORKDIR /app
COPY tools/build_native_cpu.py /app/tools/build_native_cpu.py
COPY openpilot /app/openpilot/
COPY opendbc_repo /app/opendbc_repo/
RUN python tools/build_native_cpu.py build_ext --inplace

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1
RUN apt-get update && apt-get install --no-install-recommends --yes ffmpeg \
    && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10001 carrot
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir --requirement requirements.txt
COPY --chown=carrot:carrot server.py viewer.py radar.py radar_view.js deploy_probe.py SOURCE_COMMIT /app/
COPY --from=native_builder --chown=carrot:carrot /app/openpilot /app/openpilot/
COPY --from=native_builder --chown=carrot:carrot /app/opendbc_repo /app/opendbc_repo/
RUN chmod -R a+rX /app
USER carrot
EXPOSE 8080
CMD ["python", "server.py"]
